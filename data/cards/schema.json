{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Noren card definition (reference; runtime validation is in GDScript)",
  "type": "object",
  "required": [
    "id",
    "number",
    "name",
    "type",
    "rarity",
    "cost",
    "description",
    "target",
    "effects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^noren_[0-9]{2}$"
    },
    "number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "enum": [
        "attack",
        "skill",
        "power"
      ]
    },
    "rarity": {
      "enum": [
        "C",
        "B",
        "A",
        "S"
      ]
    },
    "cost": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "cardText": {
      "type": "string"
    },
    "target": {
      "enum": [
        "self",
        "enemy",
        "all",
        "stance"
      ]
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "damage",
              "block",
              "ammo",
              "draw",
              "stance",
              "weak",
              "bleed",
              "parry",
              "parry_fill",
              "next_damage",
              "next_discount",
              "power",
              "exhaust_hand",
              "discard_attack",
              "buff"
            ],
            "description": "exhaust_hand selects another hand UID of any card type and moves it to the exhaust pile; the resolving card follows its own exhaust/type fields. discard_attack is retained for frozen old definitions and discards only another attack card."
          },
          "id": {
            "type": "string",
            "description": "For type=buff, a stable ID registered in data/buffs/buffs.json."
          },
          "buffTarget": {
            "enum": [
              "player",
              "enemy"
            ],
            "description": "Optional recipient; must agree with the buff definition."
          },
          "allAmmoHits": {
            "type": "boolean",
            "description": "In ranged stance, total hits equal 1 plus ammo before payment."
          },
          "rangedBonus": {
            "type": "integer",
            "minimum": 0,
            "description": "Flat base damage bonus in ranged stance, before the multiplier."
          },
          "bleedTriggers": {
            "type": "integer",
            "minimum": 0,
            "description": "Explicit total bleed triggers per body hit, replacing the normal stance default."
          }
        }
      }
    },
    "exhaust": {
      "type": "boolean"
    },
    "artAssetId": {
      "type": "string"
    },
    "consumeAllAmmo": {
      "type": "boolean",
      "description": "Ranged attacks consume all ammo before executing their damage segments."
    }
  }
}
