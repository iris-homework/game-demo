      "intro_04": {
        "id": "intro_04",
        "speakerId": "@player",
        "speakerSide": "left",
        "text": "三个委托，我记住了。不过，装备支援总该有一点吧？",
        "next": "intro_05"
      },
      "intro_05": {
        "id": "intro_05",
        "speakerId": "bartender",
        "speakerSide": "right",
        "text": "早给你备好了。金钱芯片、治疗芯片、迅捷芯片，挑一枚带上。剩下的，就看你自己的本事了。",
        "next": "contract"
      },
