    "nodes": {
      "intro_01": {
        "id": "intro_01",
        "speakerId": "bartender",
        "speakerSide": "right",
        "text": "欢迎来到午夜酒馆，小姑娘。最近城里不太平，缺人手的地方倒是不少。你这时候来，是想喝酒，还是想找活干？",
        "next": "intro_02"
