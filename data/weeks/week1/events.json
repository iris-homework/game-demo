      "intro_05": {
        "id": "intro_05",
        "speakerId": "dancer_black",
        "speakerSide": "right",
        "text": "放心，我不挑舞伴。跟得上枪尖，就能走。",
        "portraits": {
          "left": "",
          "right": "dancer_black"
        },
        "next": "intro_06"
      },
      "intro_06": {
        "id": "intro_06",
        "speakerId": "@player",
        "speakerSide": "left",
        "text": "后面的住户也得过这条路。把枪收起来。",
        "portraits": {
          "left": "",
          "right": "dancer_black"
        },
        "next": "intro_07"
