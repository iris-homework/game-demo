  "E15": {
    "id": "E15",
    "title": "靠岸的假灯",
    "placeId": "port",
    "unlockCondition": {},
    "repeatPolicy": "once",
    "startNodeId": "intro_01",
    "description": "夜雾里，一盏航灯漂上了装卸平台。它的触须已经伤了人，码头值守员需要你在下一艘船靠岸前清掉它。",
    "demoNote": "",
    "rewardIds": [],
    "nodes": {
      "intro_01": {
        "id": "intro_01",
        "speakerId": "",
        "speakerSide": "",
        "text": "雾里的琥珀色亮点缓慢起伏。走近后，{主角姓名}看见灯壳外包着一层薄膜，触须正从缆绳间探出来。",
        "next": "intro_02",
        "type": "stage",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "intro_02": {
        "id": "intro_02",
        "speakerId": "dock_keeper",
        "speakerSide": "right",
        "text": "别往前。刚才有人把它当成掉下来的航灯，手差点被刺穿。",
        "next": "intro_03",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "intro_03": {
        "id": "intro_03",
        "speakerId": "@player",
        "speakerSide": "left",
        "text": "人送走了吗？",
        "next": "intro_04",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "intro_04": {
        "id": "intro_04",
        "speakerId": "dock_keeper",
        "speakerSide": "right",
        "text": "送去处理了。平台也封了，可船不能一直等在外面。",
        "next": "intro_05",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "intro_05": {
        "id": "intro_05",
        "speakerId": "@player",
        "speakerSide": "left",
        "text": "它追着灯过来的？能把它引回水里吗？",
        "next": "intro_06",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "intro_06": {
        "id": "intro_06",
        "speakerId": "dock_keeper",
        "speakerSide": "right",
        "text": "试过。灯关了，它就贴着缆绳走。引到边上又回来了。",
        "next": "intro_07",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "intro_07": {
        "id": "intro_07",
        "speakerId": "",
        "speakerSide": "",
        "text": "水母收紧伞缘，一束触须突然刺向地上的系船钩，拖出短促的刮擦声。",
        "next": "intro_08",
        "type": "stage",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "intro_08": {
        "id": "intro_08",
        "speakerId": "@player",
        "speakerSide": "left",
        "text": "把工人都留在栏杆外。别再拿东西试它。",
        "next": "intro_09",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "intro_09": {
        "id": "intro_09",
        "speakerId": "dock_keeper",
        "speakerSide": "right",
        "text": "清理费按委托付。你要准备，我就继续拦着这边。",
        "next": "fight_01",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "choice": {
        "id": "choice",
        "type": "stage",
        "speakerId": "",
        "speakerSide": "",
        "text": "{主角姓名}跨过封锁位置，水母感知到靠近的活动目标。",
        "next": "battle",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "fight_01": {
        "id": "fight_01",
        "type": "stage",
        "speakerId": "",
        "speakerSide": "",
        "text": "{主角姓名}跨过封锁位置，水母感知到靠近的活动目标。",
        "next": "battle",
        "portraits": {
          "right": "beacon_jellyfish"
        }
      },
      "leave_01": {
        "id": "leave_01",
        "type": "stage",
        "speakerId": "",
        "speakerSide": "",
        "text": "{主角姓名}退回安全通道，值守员继续封锁平台。",
        "next": "@map",
        "portraits": {
          "right": ""
        }
      },
      "battle": {
        "id": "battle",
        "type": "battle",
        "battleId": "B15"
      },
      "win_01": {
        "id": "win_01",
        "speakerId": "",
        "speakerSide": "",
        "text": "浮囊慢慢瘪下去，旧信标壳撞在地上。触须停止抽动，中心的光也熄灭了。",
        "next": "win_02",
        "type": "stage",
        "portraits": {
          "right": ""
        }
      },
      "win_02": {
        "id": "win_02",
        "speakerId": "dock_keeper",
        "speakerSide": "right",
        "text": "这下能让大家上来了吧？",
        "next": "win_03",
        "portraits": {
          "right": ""
        }
      },
      "win_03": {
        "id": "win_03",
        "speakerId": "@player",
        "speakerSide": "left",
        "text": "先清掉这些东西。触须别用手碰，地上那层液体也处理干净。",
        "next": "win_04",
        "portraits": {
          "right": ""
        }
      },
      "win_04": {
        "id": "win_04",
        "speakerId": "",
        "speakerSide": "",
        "text": "值守员叫来穿防护装备的清理人员，确认平台可以通行后，才撤开封锁带。",
        "next": "win_05",
        "type": "stage",
        "portraits": {
          "right": ""
        }
      },
      "win_05": {
        "id": "win_05",
        "speakerId": "dock_keeper",
        "speakerSide": "right",
        "text": "这边恢复作业。委托我确认了，靠泊队也会检查那批浮标。",
        "next": "win_06",
        "portraits": {
          "right": ""
        }
      },
      "win_06": {
        "id": "win_06",
        "speakerId": "@player",
        "speakerSide": "left",
        "text": "好。我去洗一下鞋底，你们接着忙。",
        "next": "finish",
        "portraits": {
          "right": ""
        }
      },
      "lose": {
        "id": "lose",
