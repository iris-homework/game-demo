      },
      "intro_03": {
        "id": "intro_03",
        "speakerId": "bartender",
        "speakerSide": "right",
        "text": "想在这里站稳脚跟，就自己去城里找委托做。完成三个不同的委托，再回来找我，我给你一份额外奖励。",
        "next": "intro_04"
