    "rewardIds": [],
    "nodes": {
      "intro_01": {
        "id": "intro_01",
        "speakerId": "bartender",
        "speakerSide": "right",
        "text": "欢迎来到午夜酒馆，小姑娘。最近城里不太平，缺人手的地方倒是不少。你这时候来，是想喝酒，还是想找活干？",
        "next": "intro_02"
      },
      "intro_02": {
        "id": "intro_02",
        "speakerId": "@player",
        "speakerSide": "left",
        "text": "找活干。我是自由佣兵，按委托办事。听说你这里门路不少。",
